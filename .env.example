# Clave del panel /admin (cámbiala antes de publicar)
ADMIN_PASSWORD=moodboard-admin

# Secreto para firmar la sesión del panel
JWT_SECRET=cambia-este-secreto

# URL pública del API. Déjala vacía para usar el mismo origen (Next hace proxy).
# Solo necesitas cambiarla si el API vive en otro dominio.
NEXT_PUBLIC_API_URL=

# URL interna del API para los rewrites de Next (en Docker: http://api:4000)
# API_INTERNAL_URL=http://api:4000

# Origen permitido para el API
WEB_ORIGIN=http://localhost:3000

# Base de datos Postgres
POSTGRES_DB=moodboard
POSTGRES_USER=moodboard
POSTGRES_PASSWORD=moodboard
