# Clave del panel /admin (cámbiala antes de publicar)
ADMIN_PASSWORD=cambia-esta-contrasena

# Secreto para firmar la sesión del panel (genera uno aleatorio)
JWT_SECRET=genera-un-secreto-aleatorio

# URL pública del API. Déjala vacía para usar el mismo origen (Next hace proxy).
# Solo necesitas cambiarla si el API vive en otro dominio.
NEXT_PUBLIC_API_URL=

# URL interna del API para los rewrites de Next (en Docker: http://api:4000)
# API_INTERNAL_URL=http://api:4000

# Origen permitido para el API
WEB_ORIGIN=http://localhost:3000

# Base de datos Postgres
POSTGRES_DB=moodboard
POSTGRES_USER=moodboard
POSTGRES_PASSWORD=cambia-esta-contrasena

# Opcional para producción (Prisma Postgres, Neon, Supabase, etc.). Si se define,
# tiene prioridad sobre POSTGRES_* y DB_*. `DATABASE_URL_POOLED` tiene prioridad
# sobre `DATABASE_URL`. Activa DB_SSL=true si el proveedor lo exige.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# DATABASE_URL_POOLED=postgresql://usuario:clave@host-pooler/base?sslmode=require
# DB_SSL=false
